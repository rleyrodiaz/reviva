DATABASE_URL=postgresql://postgres:password@localhost:5432/reviva
SECRET_KEY=change-me-to-a-long-random-string
# Usadas por scripts/setup_mvp.py y los scripts de smoke test para loguearse
# como superadmin — nunca las hardcodees en el código.
SUPERADMIN_EMAIL=admin@example.com
SUPERADMIN_NOMBRE=Admin
SUPERADMIN_PASSWORD=change-me
SESSION_MAX_AGE_HOURS=12
# true: el botón "Abrir" del chat del paciente se abre en un modal dentro de
# la misma pestaña (para que una sola persona prueba la app pueda hacer de
# usuario y de paciente a la vez). false (default): se abre en una pestaña
# nueva, como en uso real (paciente y familiar en dispositivos separados).
MODO_DEMO=false
# Proveedor y modelo del clasificador de respuestas libres: "anthropic" u "openai".
IA_PROVEEDOR=anthropic
IA_MODELO=claude-haiku-4-5-20251001
ANTHROPIC_API_KEY=your-anthropic-api-key-here
OPENAI_API_KEY=
# Cifra las API keys que cada familia carga desde Settings > API Keys.
# Opcional: si queda vacía, se deriva de SECRET_KEY.
API_KEYS_ENCRYPTION_KEY=

# Generar con: py_vapid (ver scripts/generar_vapid.py)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY_PATH=vapid_private_key.pem
VAPID_CLAIMS_EMAIL=admin@example.com
